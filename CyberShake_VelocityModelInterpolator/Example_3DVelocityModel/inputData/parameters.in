# =====================================================================
# Velocity Model Interpolation Parameters for Cybershake Mesh
# =====================================================================
# This configuration file contains input parameters for interpolating  
# and mapping a 1D velocity model into a 3D structured mesh, following  
# the Cybershake format. 
#
# Usage:
# - Ensure this file is properly formatted before running the script.
# - Modify parameters as needed to match the target region and model.
#
# Notes:
# - The name of this input file cannot be changed (parameters.in)
# - The input velocity model must be provided as a Tab-delimited file 
#   or a CSV file.
# - Set 'is_anelastic' to True if Qp and Qs are included in the model.
# - The output folder must exist or be writable for storing results.
# - Cybershake domain's corners conventions:
#
# Rotation:
# A model with model_rot=0 corresponds to the figure shown below. 
# Note that the coordinate origin is at C1.
#
#     (North ↑)
#         ^ 
#         |
#        C1 --------- C2 --> (East →)
#         |           |  
#         |  Model    |  
#         |  Domain   |  
#         |           |  
#         |           |  
#         |           |  
#         |           |  
#        C4 --------- C3 
#
# When model_rot=-90 (rotation of 90° counterclockwise around C1), the model appears as follows:
#
#     (North ↑)
#         ^ 
#         |
#        C2 ------------------- C3
#         |                     |  
#         |       Model         |  
#         |       Domain        |  
#         |                     |  
#        C1 ------------------- C4 --> (East →)
#                   
# Author: Andrea C. Riaño
# Email: andrea.riano@bsc.es
# Date: [2025-01-29]
# ====================================================================

# Path to the inputData folder and name of the velocity model file
# The VM file contains the 3D velocity model data used for interpolation (possible input formats: csv, txt, nc, json)
input_folder=Example_3DVelocityModel/inputData/
vm_file=cvms5_1d_depth_socal.nc
velocity_units=km/s
density_units=g/cm3

# Set is_anelastic to False for an elastic model (Vp, Vs, and Rho only); set to True for an anelastic model.
is_anelastic=False

# Longitude and latitude of the domain's C1 corner (in degrees)
# This represents the geographic longitude and latitude of the model's C1 point (Cybershake notation).
model_lon=-119.38
model_lat=34.13

# Length of the model domain along the X-axis (in kilometers)
# This is the total distance (in km) the model will cover along the east-west direction if model_rot = 0 or distances between C1 to C4 = C2 to C3
x_length=200

# Length of the model domain along the Y-axis (in kilometers)
# This is the total distance (in km) the model will cover along the north-south direction if model_rot = 0 or distances between C1 to C2 = C4 to C3
y_length=120

# Length of the model domain along the Z-axis (in kilometers)
# This is the total depth (in km) of the model from the surface to the bottom.
z_length=30

# Rotation of the simulation domain. A value of of -30 means the model's 
# orientation is rotated by 30 degrees clockwise from the north.
model_rot=-30

# Grid spacing (in kilometers)
# This defines the distance between each grid point in the model.
# A value of 2 means the grid will have a spacing of 2 km between each point.
grid_spacing=1

# Name of the region (for reference)
# This is a label for the region where the model is located (e.g., Southern California).
region=SouthernCalifornia

# Variable to plot ('Vp', 'Vs', 'Rho', and if_anelastic=true, 'Qp', and 'Qs') 
variable_name=Vp

# Plane to plot (XZ or YZ at index in the local Y or X dir, respectively) 
plane_type=XZ
index=10 

# XY surface is plotted by default at the indicated index_z 
index_z=0 

# Create domain's and grid's dynamic map 
# Keep in mind that depending on the number of nodes, grid map can take a while to print to kml and html. 
Domain_dynmap=True
Grid_dynmap=False

# Optional. How the mesh treats low velocities and the surface. Leave them commented out to
# get the mesh this program has always written.
# min_vs      minimum Vs in m/s (default 500). The minimum Vp is 3.4 times it and the minimum
#             density takes that same number, the rule of the SCEC mesher.
# format      awp (default) or awpz. Where Vs is raised to the minimum at the surface, awp keeps
#             the Vp/Vs of that point and awpz uses the Vp/Vs of the point below, at most 4.
# h_fraction  depth of the surface layer as a fraction of the grid spacing (default 0.25).
#min_vs=500
#format=awp
#h_fraction=0.25

# Folder path where the output files will be saved
# This is the directory where all generated model files and plots will be saved.
output_folder=Example_3DVelocityModel/outputData/
