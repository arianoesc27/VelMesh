# =====================================================================
# Velocity Model Interpolation / Partition Parameters for CyberShake
# =====================================================================
# This configuration file defines the input parameters used to:
#   1) interpolate a velocity model onto a 3D structured mesh, and/or
#   2) compute a CPU or GPU partitioning of that mesh.
#
# General philosophy:
# - The user mainly provides the physical domain and physical/numerical
#   parameters.
# - The mesh definition (grid_spacing, nx, ny, nz) can be computed
#   automatically by the workflow.
# - If nx, ny, and nz are present in this file, they take precedence and
#   are treated as the final resolved mesh.
# - CPU/GPU partitioning scripts should write the final mesh values back
#   into this file so that the interpolator uses exactly the same mesh.
#
# Recommended convention:
# - x_length, y_length, z_length: required as physical domain input.
# - grid_spacing: required if running the interpolator in standalone mode.
# - nx, ny, nz: optional for the user; typically auto-generated by the
#   workflow.
#
# Important notes:
# - The name of this file should remain: parameters.in
# - If is_anelastic = True, the velocity model is expected to include
#   attenuation-related quantities (e.g., Qp and Qs).
#
# CyberShake domain corner convention:
#
# Rotation:
# A model with model_rot = 0 corresponds to the figure shown below.
# The coordinate origin is located at corner C1.
#
#     (North ↑)
#         ^
#         |
#        C1 --------- C2 --> (East →)
#         |           |
#         |  Model    |
#         |  Domain   |
#         |           |
#         |           |
#         |           |
#         |           |
#        C4 --------- C3
#
# When model_rot = -90 (90° counterclockwise rotation around C1),
# the model appears as follows:
#
#     (North ↑)
#         ^
#         |
#        C2 ------------------- C3
#         |                     |
#         |       Model         |
#         |       Domain        |
#         |                     |
#        C1 ------------------- C4 --> (East →)
#
# Author: Andrea C. Riaño
# Email: andrea.riano@bsc.es
# Date: [2025-01-29]
# =====================================================================

# =====================================================================
# 1. File Parameters  [REQUIRED]
# =====================================================================
input_folder = inputData/
vm_file = cvms5_1d_depth_socal.nc
output_folder = outputData/

# =====================================================================
# 2. Units  [REQUIRED]
# =====================================================================
velocity_units = km/s
density_units = kg/m3

# =====================================================================
# 3. Partitioning Parameters  [OPTIONAL]
# =====================================================================
# These parameters are only needed if CPU or GPU partitioning is used.
# They are not required when running only the velocity-model interpolator.

# ---------------------------------------------------------------------
# 3.1 CPU partitioning
# ---------------------------------------------------------------------
# Number of CPU cores available per node.
cores_per_node = 112

# Target number of mesh points per CPU core.
# Used to estimate the number of CPU cores/nodes required.
points_per_core = 450000

# ---------------------------------------------------------------------
# 3.2 GPU partitioning
# ---------------------------------------------------------------------
# Number of GPUs available per node.
gpus_per_node = 4

# Target number of mesh points per GPU.
# Used to estimate the number of GPUs/nodes required.
points_per_gpu = 100000000

# ---------------------------------------------------------------------
# 3.3 GPU Z-blocking
# ---------------------------------------------------------------------
# z_block controls the adjustment of the number of cells in the Z direction.
# The final nz will be forced to be a multiple of this value.
#
# If z_block is explicitly defined, that value is used as-is.
# If z_block is not defined, the code may suggest one automatically.
z_block = 200

# Optional. The block sizes AWP has a compiled binary for (one pmcl3d<N> per size). The
# automatic choice only picks among these. Left commented out, the list built on
# MareNostrum 5 is used, 32 to 512 in steps of 32, plus 200 and 252. None can exceed 512.
#available_z_blocks = 32,64,96,128,160,192,200,224,252,256,288,320,352,384,416,448,480,512

# This option is only used when z_block is NOT explicitly provided.
# If True, the code prefers a z_block that is a multiple of 32, which is the GPU warp size.
# A multiple of 32 keeps the warps lined up with the rows of Z. Either way, a value that
# divides nz exactly is preferred first, so the model depth never has to change.
prefer_multiple_of_32_z_block = True

# Maximum allowed relative difference between the target nz and the
# adjusted nz when the code auto-selects z_block.
z_block_max_relative_error = 0.10

# =====================================================================
# 4. Physical / Numerical Domain  [REQUIRED]
# =====================================================================
# Desired physical dimensions of the model domain (km).
x_length = 290
y_length = 170
z_length = 40.0

# Domain rotation (degrees).
model_rot = -60

# Resolution-related parameters.
f_max = 1
ppwl = 11.5
vs_min = 2300

# Effective grid spacing in km.
# - REQUIRED if running the interpolator in standalone mode without
#   previous partitioning.
# - OPTIONAL / AUTO-GENERATED if partitioning is run first.
grid_spacing = 0.2

# =====================================================================
# 5. Optional Workflow Hints  [OPTIONAL]
# =====================================================================
# mesh_mode:
# - auto        -> use nx, ny, nz if present; otherwise compute them
# - standalone  -> force mesh computation from lengths + grid_spacing
# - cpu         -> expect CPU partitioning to provide a consistent mesh
# - gpu         -> expect GPU partitioning to provide a consistent mesh
#                  and validate the GPU Z-blocking rules
mesh_mode = gpu

# =====================================================================
# 6. Velocity Model Parameters  [REQUIRED]
# =====================================================================
is_anelastic = False
variable_name = Vs
plane_type = XZ
index = 5
index_z = 0

# =====================================================================
# 7. Geographic Parameters  [REQUIRED]
# =====================================================================
model_lon = -119.667122
model_lat = 34.033848
region = SoCal

# =====================================================================
# 8. Visualization Flags  [OPTIONAL]
# =====================================================================
Domain_dynmap = True
Grid_dynmap = False

# =====================================================================
# 9. Derived Mesh Parameters  [OPTIONAL / AUTO-GENERATED]
# =====================================================================
# NOTE: If these values exist, they override automatic mesh recomputation.
# These values are usually generated automatically by the workflow.
# Users should not normally edit them manually.
#
# IMPORTANT:
# - If nx, ny, and nz are present in this file, they will be reused in the next run.
# - If nx, ny, and nz are not present, the code will compute them automatically.
# - Delete nx, ny, and nz if you want the code to generate a new mesh.
#
# This means:
# - Keeping nx, ny, and nz will reuse the same mesh in future runs.
# - Deleting nx, ny, and nz will force the code to recompute the mesh.
#
# If you change the domain size or the resolution settings and want a new
# mesh, you must delete nx, ny, and nz before running again.
#
# Auto-generated values will appear below after the mesh is resolved:
# nx = ...
# ny = ...
# nz = ...
